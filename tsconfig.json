{
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "eslint.config.js",
    "prettier.config.js",
    "vite.config.js",
    /* Named explicitly because `**` does not descend into a dot-directory: without this line
       the hook tests compile in no project at all, and vitest transpiles each file on its own,
       so a type error there is never reported by anything. */
    ".claude/hooks/__tests__/**/*.ts"
  ],

  // Cezar's worktrees live under `.ai/cezar/worktrees/`, a dot-directory the wildcard
  // patterns above never enter, so the default exclude is all this needs.
  "exclude": ["node_modules"],

  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    /* `ES2023.Intl` is type-only: it declares the string form of `useGrouping`,
       which `src/lib/format-tables.ts` freezes per locale. */
    "lib": ["ES2022", "ES2023.Intl", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
