{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // The rule set `@tanstack/eslint-config` gave ESLint, carried over by `@oxlint/migrate` with the
  // same exceptions this repository made to it (ADR 0028). Four preset rules have no oxlint
  // counterpart and are gone: `@typescript-eslint/naming-convention` (the `T`-prefix on type
  // parameters), `@stylistic/spaced-comment`, `no-octal` (a syntax error in strict-mode modules
  // anyway) and the type-aware trio this repository had already switched off.
  // `node/prefer-node-protocol` lives on as `unicorn/prefer-node-protocol`.
  //
  // Everything a `.gitignore` refuses to track is skipped by oxlint itself, the nested
  // `.ai/**/.gitignore` files included - so a scratch directory an agent run writes can no longer
  // turn `pnpm lint` red the way #203 did, and `ignorePatterns` below only names tracked paths
  // that are not ours to lint. `eslint.config.test.ts` became `lint-ignores.test.ts`, which pins
  // both halves.
  "plugins": ["import", "typescript", "unicorn"],
  "categories": { "correctness": "off" },
  "env": { "builtin": true },
  "ignorePatterns": [
    "prettier.config.js",
    // Ignored one level at a time, and not with `.claude/**` plus a negation: these are gitignore
    // semantics, so a path inside an excluded *directory* can never be re-included - the directory
    // is pruned before the negation is read. The shorter form silently ignores the tests below.
    ".claude/*",
    "!.claude/hooks",
    ".claude/hooks/*",
    // The hook tests are the carve-out: `tsconfig.json` names the path, so they are ordinary
    // TypeScript in this project.
    "!.claude/hooks/__tests__",
    // Agent tooling that GitHub's own surfaces read - skills, agent definitions, hooks. Same
    // reason `.claude/*` is here: vendored configuration for tools around the project, not
    // application source.
    ".github/**"
  ],
  "overrides": [
    {
      // The preset's own scope. `.mjs` and `.cjs` files were linted under no rule at all, and
      // still are.
      "files": ["**/*.{js,ts,tsx}"],
      "env": { "es2020": true, "browser": true },
      "rules": {
        "for-direction": "error",
        "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
        "import/first": "error",
        "import/newline-after-import": "error",
        "import/no-commonjs": "error",
        "import/no-duplicates": "error",
        "no-async-promise-executor": "error",
        "no-case-declarations": "error",
        "no-class-assign": "error",
        "no-compare-neg-zero": "error",
        "no-cond-assign": "error",
        "no-constant-binary-expression": "error",
        "no-constant-condition": "error",
        "no-control-regex": "error",
        "no-debugger": "error",
        "no-delete-var": "error",
        "no-dupe-else-if": "error",
        "no-duplicate-case": "error",
        "no-empty-character-class": "error",
        "no-empty-pattern": "error",
        "no-empty-static-block": "error",
        "no-ex-assign": "error",
        "no-extra-boolean-cast": "error",
        "no-fallthrough": "error",
        "no-global-assign": "error",
        "no-invalid-regexp": "error",
        "no-irregular-whitespace": "error",
        "no-loss-of-precision": "error",
        "no-misleading-character-class": "error",
        "no-nonoctal-decimal-escape": "error",
        "no-regex-spaces": "error",
        // A package's root entry evaluates all of it. Tests pay for that per file, and components/ui
        // hands it to every test through the barrel. Repeated in each override below that sets
        // this rule, since an override replaces its options.
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "date-fns",
                "allowTypeImports": true,
                "message": "Import each function from its own entry, e.g. date-fns/addDays. The root loads every function: 1.7 s in every test file that reaches it."
              },
              {
                "name": "radix-ui",
                "allowTypeImports": true,
                "message": "Import the primitive from its own entry, e.g. import * as Dialog from 'radix-ui/dialog'. The root loads every primitive."
              }
            ]
          }
        ],
        "no-self-assign": "error",
        "no-shadow": "warn",
        "no-shadow-restricted-names": "error",
        "no-sparse-arrays": "error",
        "no-unsafe-finally": "error",
        "no-unsafe-optional-chaining": "error",
        "no-unused-labels": "error",
        "no-unused-private-class-members": "error",
        "no-useless-backreference": "error",
        "no-useless-catch": "error",
        "no-useless-escape": "error",
        "no-var": "error",
        "no-with": "error",
        "prefer-const": "error",
        "require-yield": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "ts-expect-error": false,
            "ts-ignore": "allow-with-description"
          }
        ],
        "typescript/consistent-type-imports": [
          "error",
          {
            "prefer": "type-imports"
          }
        ],
        "typescript/method-signature-style": ["error", "property"],
        "typescript/no-duplicate-enum-values": "error",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-inferrable-types": [
          "error",
          {
            "ignoreParameters": true
          }
        ],
        "typescript/no-misused-new": "error",
        "typescript/no-namespace": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-for-of": "warn",
        "typescript/triple-slash-reference": "error",
        "unicorn/prefer-node-protocol": "error",
        "use-isnan": "error",
        "valid-typeof": "error"
      }
    },
    {
      // Layering law (docs/SPEC.md §6): all SQL lives in server/repos (catalog is the single
      // stated exception). Client-side layers never see drizzle-orm.
      "files": ["src/components/**", "src/lib/**", "src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "SQL lives in server/repos via the tenant base repository (docs/SPEC.md §6). Call a server function instead."
              },
              {
                "name": "date-fns",
                "allowTypeImports": true,
                "message": "Import each function from its own entry, e.g. date-fns/addDays. The root loads every function: 1.7 s in every test file that reaches it."
              },
              {
                "name": "radix-ui",
                "allowTypeImports": true,
                "message": "Import the primitive from its own entry, e.g. import * as Dialog from 'radix-ui/dialog'. The root loads every primitive."
              }
            ],
            "patterns": [
              {
                "group": ["drizzle-orm/*"],
                "message": "SQL lives in server/repos via the tenant base repository (docs/SPEC.md §6). Call a server function instead."
              }
            ]
          }
        ]
      }
    },
    {
      // The dev seed route stays outside the layering law, as it was under ESLint. An override
      // cannot carry its own `ignores`, so a later one switches the rule back off instead.
      "files": ["src/routes/api/dev/-seed/**"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      // Layering law (docs/SPEC.md §6): design-system primitives never reach the server layer.
      // After the block above so it wins (and therefore must repeat) the drizzle-orm restriction -
      // an override replaces a rule's options wholesale, it does not merge them.
      "files": ["src/components/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "SQL lives in server/repos via the tenant base repository (docs/SPEC.md §6). Call a server function instead."
              },
              {
                "name": "date-fns",
                "allowTypeImports": true,
                "message": "Import each function from its own entry, e.g. date-fns/addDays. The root loads every function: 1.7 s in every test file that reaches it."
              },
              {
                "name": "radix-ui",
                "allowTypeImports": true,
                "message": "Import the primitive from its own entry, e.g. import * as Dialog from 'radix-ui/dialog'. The root loads every primitive."
              }
            ],
            "patterns": [
              {
                "group": ["#/server/*", "@/server/*", "**/server/*"],
                "message": "components/ui never imports from server/ (docs/SPEC.md §6). Pass data in as props."
              },
              {
                "group": ["drizzle-orm/*"],
                "message": "SQL lives in server/repos via the tenant base repository (docs/SPEC.md §6). Call a server function instead."
              }
            ]
          }
        ]
      }
    }
  ]
}
