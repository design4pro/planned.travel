# Auth for the Claude Code CLI inside the sandbox — one of:
# CLAUDE_CODE_OAUTH_TOKEN=   # from `claude setup-token`
# ANTHROPIC_API_KEY=

# GitHub token for `gh` inside the sandbox (issues read/comment/close).
# A fine-grained PAT with Issues read/write on design4pro/planned.travel is enough.
# GH_TOKEN=

# Only needed when a sandbox runs the Playwright suite (setup-e2e.sh) and the
# basemap is not already cached in .e2e-tiles/: R2:read on planned-travel-tiles.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Dated, immutable archive key (docs/DEPLOY.md 7.4), e.g. basemaps/planet-20260818.pmtiles
# TILES_KEY=
