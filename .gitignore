# Dependencies
node_modules

# Build output
dist
dist-ssr
.output
.nitro
.vinxi
.tanstack

# Local Cloudflare state: Miniflare's D1/KV/R2/DO simulators live here.
.wrangler

# Secrets. `.dev.vars` is the local equivalent of `wrangler secret put`, and
# `.env*` files feed `import.meta.env` at build time. Both hold live keys.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.local

# Test and coverage artefacts. Playwright screenshot baselines are NOT ignored:
# they live in e2e/__screenshots__ and are reviewed like source.
coverage
playwright-report
blob-report
test-results
playwright/.cache

# Editor and OS noise
.DS_Store
*.log
__unconfig*
todos.json

# /ultrabuild run state: contract pointer, item statuses, findings and the blind
# A/B screenshot pairs. The command definitions in .claude/ are tracked; only the
# per-run scratch is not.
#
# `knowledge/` is the exception and is tracked on purpose. It holds what the loop
# MEASURED rather than what it produced — the settled environment facts, the
# claims already refuted, and the deferred backlog — and it is the only thing that
# survives a run being archived. Ignoring it is how the same port, theme and
# capture mistakes were rediscovered in two consecutive runs at a cost of roughly
# a hundred findings. Everything else here is derived and disposable.
.claude/ultrabuild/*
!.claude/ultrabuild/knowledge/

# One cached demo session per e2e run, written by e2e/auth.setup.ts.
e2e/.auth

# Playwright MCP scratch output (page snapshots, console dumps).
.playwright-mcp

# Local MCP server config. Developer-specific, never shared.
.mcp.json

# Scratch a browser agent drops in the working directory. The repo's own images
# live under e2e/__screenshots__ and .claude/ultrabuild/shots, and its own
# scripts live under scripts/, so nothing legitimate is a bare image or a bare
# .mjs at the root. Ignoring them is the backstop; the rule that they belong in
# .claude/ultrabuild/shots is in BROWSER_POLICY in .claude/workflows/ultrabuild.js.
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.mjs

# /ultrabuild: generated per-round wrapper, rebuilt by scripts/ultrabuild/build-round.mjs
.claude/ultrabuild/round.js

# Tracked on purpose: a product screenshot, not a round capture.
!billing-light.png

# Sandcastle loop state: agent worktrees and logs live inside the repo by design.
.sandcastle/worktrees/
.sandcastle/logs/
