# Dependencies
node_modules

# Build output
dist
dist-ssr
.output
.nitro
.vinxi
.tanstack

# Local Cloudflare state: Miniflare's D1/KV/R2/DO simulators live here.
.wrangler

# Secrets. `.dev.vars` is the local equivalent of `wrangler secret put`, and
# `.env*` files feed `import.meta.env` at build time. Both hold live keys.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.local

# Test and coverage artefacts. Every one of these is generated by a run and none
# of it is reviewed: since ADR 0016 no image in this repo is a baseline, so there
# is no longer any Playwright output that belongs in the tree.
coverage
playwright-report
blob-report
test-results
playwright/.cache

# Editor and OS noise
.DS_Store
*.log
__unconfig*
todos.json

# One cached demo session per e2e run, written by e2e/auth.setup.ts.
e2e/.auth

# Playwright MCP scratch output (page snapshots, console dumps).
.playwright-mcp

# Local MCP server config. Developer-specific, never shared.
.mcp.json
# Claude Code per-developer overrides (which of those MCP servers to enable, extra
# permission rules). Shared settings and hooks live in .claude/settings.json.
.claude/settings.local.json

# Scratch a browser agent drops in the working directory. The blind pairs belong
# outside the repository entirely (the session scratchpad, or .sandcastle-shots/
# when a tool insists on a path inside it) and the repo's own scripts live under
# scripts/, so nothing legitimate is a bare image or a bare .mjs at the root. Ignoring them is the backstop; an
# untracked screenshot in the repo root has already broken the clean-room
# boundary once (docs/SPEC.md §2, "capture hygiene").
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.mjs

# Tracked on purpose: a product screenshot, not a capture artefact.
!billing-light.png

# pnpm's fallback store, when pnpm cannot reach its default store directory.
.pnpm-store/

# Blind A/B frames from scripts/visual/capture.mjs (the `--out` its docs suggest).
.sandcastle-shots/

# Local basemap cache for e2e (pulled from R2).
.e2e-tiles/
dev-server.log

# Impeccable design skill. Three files in here are project truth and are tracked
# on purpose: `design.json` is the DESIGN.md sidecar (tonal ramps, shadows,
# motion, and the component snippets the live panel renders), `config.json`
# holds the project's build-path setting, and `live/config.json` is the one-time
# live-mode setup so the next person does not repeat it. Everything else is
# per-machine or per-session: `config.local.json` is the local override by
# design, `roots.json` and `inject-journal.json` are absolute paths and PIDs
# from this checkout, `server.json` carries the live helper's port and its
# bearer token, and `sessions/` is the append-only event journal. None of that
# means anything in another clone, and the token means rather too much.
.impeccable/config.local.json
.impeccable/live/roots.json
.impeccable/live/server.json
.impeccable/live/inject-journal.json
.impeccable/live/sessions/

# Generated by live mode, and only while it is running: the dev-only component
# that appends the picker bundle after hydration. `live-inject.mjs --remove`
# deletes it on exit, so a copy in a commit is a leftover, never a source file.
# The four-line mount it pairs with is in `src/routes/__root.tsx`, which is
# tracked and therefore has to come out of the diff by hand.
src/impeccable/


# Per-run scratch of the retired repository-orchestrated workflows: port pin, ladder verdicts
# and digests, handoff. Never committed; the agent's PR carries what matters.
.agent/

# The SQL the airport loader generates on its way to D1 (scripts/seed/airports.mjs
# --sql-out, which the deploy workflows use). A megabyte of INSERTs regenerated
# from the committed artefact every time, so it is output rather than source.
airports.sql

# om-prepare-test-env working state: the live-environment descriptor, the demo
# credential env file the up script writes beside it, QA screenshot artefacts
# and per-run scratch of the om-* skills. The scripts that produce them are
# tracked; their output never is.
.ai/qa/test-env.json
.ai/qa/test-env.env
.ai/qa/test-env-build-cache.json
.ai/qa/test-env.lock/
.ai/qa/dev-server.pid
.ai/qa/dev-server-process.json
.ai/qa/artifacts_*/
.ai/tmp/
node_modules/
.e2e/results/
.e2e/cache/
.e2e/sessions/
.e2e/report.json
.e2e/ai-trace.json
