# Dependencies
node_modules

# Build output
dist
dist-ssr
.output
.nitro
.vinxi
.tanstack

# Local Cloudflare state: Miniflare's D1/KV/R2/DO simulators live here.
.wrangler

# Secrets. `.dev.vars` is the local equivalent of `wrangler secret put`, and
# `.env*` files feed `import.meta.env` at build time. Both hold live keys.
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example
*.local

# Test and coverage artefacts. Playwright screenshot baselines are NOT ignored:
# they live in e2e/__screenshots__ and are reviewed like source.
coverage
playwright-report
blob-report
test-results
playwright/.cache

# Editor and OS noise
.DS_Store
*.log
__unconfig*
todos.json

# One cached demo session per e2e run, written by e2e/auth.setup.ts.
e2e/.auth

# Playwright MCP scratch output (page snapshots, console dumps).
.playwright-mcp

# Local MCP server config. Developer-specific, never shared.
.mcp.json

# Scratch a browser agent drops in the working directory. The repo's own images
# live under e2e/__screenshots__, the visual gate's blind pairs under
# .sandcastle-shots/, and its own scripts under scripts/, so nothing legitimate
# is a bare image or a bare .mjs at the root. Ignoring them is the backstop; an
# untracked screenshot in the repo root has already broken the clean-room
# boundary once (docs/SPEC.md §2, "capture hygiene").
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.mjs

# Tracked on purpose: a product screenshot, not a capture artefact.
!billing-light.png

# Sandcastle loop state: agent worktrees and logs live inside the repo by design.
.sandcastle/worktrees/
.sandcastle/logs/

# Data shared between sandboxes and kept across runs — the pnpm store and the
# e2e basemap — bind-mounted into every container by .sandcastle/sandbox. The
# worktrees above are deleted after each run, so anything cached inside one is
# lost; this is where a cache has to live to survive. The root .e2e-tiles/
# below is a separate cache, for CI and a local `pnpm e2e`.
.sandcastle/sandbox/data/

# pnpm's fallback store. In the sandbox pnpm's default store (~/.local/share/
# pnpm) is on the container overlay while the project is a bind mount, so pnpm
# puts the store on the project's filesystem instead: <mount-root>/.pnpm-store,
# i.e. the worktree root. Ignoring it is what lets sandcastle see the worktree
# as clean and remove it after a run (cleanupWorktree runs `git status
# --porcelain`); six 823 MB stores survived one triage sweep before this line.
# Kept as the backstop now that .sandcastle/sandbox mounts a real store.
.pnpm-store/

# Sandcastle run artifacts, all written into the sandbox worktree root and
# copied to .sandcastle/logs: the validation ladder's JSON verdict, which
# main.ts asks for on every run with `validate.sh --json-out`, and the advisory
# pass's scratch — the pixel-critic's blind A/B frames and verdict, and the
# deep review's structural report. Untracked files left in the worktree are
# what stops sandcastle from removing it, so every artifact a run leaves behind
# has to be ignored somewhere in this file; the three that carry no
# `.sandcastle-` prefix — playwright-report, test-results and dev-server.log —
# already have entries of their own.
.sandcastle-validation.json
.sandcastle-shots/
.sandcastle-visual.json
.sandcastle-deep-review.json

# Local basemap cache for e2e (pulled from R2; copied into sandcastle worktrees).
.e2e-tiles/
dev-server.log

# Impeccable design skill. Three files in here are project truth and are tracked
# on purpose: `design.json` is the DESIGN.md sidecar (tonal ramps, shadows,
# motion, and the component snippets the live panel renders), `config.json`
# holds the project's build-path setting, and `live/config.json` is the one-time
# live-mode setup so the next person does not repeat it. Everything else is
# per-machine or per-session: `config.local.json` is the local override by
# design, `roots.json` and `inject-journal.json` are absolute paths and PIDs
# from this checkout, `server.json` carries the live helper's port and its
# bearer token, and `sessions/` is the append-only event journal. None of that
# means anything in another clone, and the token means rather too much.
.impeccable/config.local.json
.impeccable/live/roots.json
.impeccable/live/server.json
.impeccable/live/inject-journal.json
.impeccable/live/sessions/

# Generated by live mode, and only while it is running: the dev-only component
# that appends the picker bundle after hydration. `live-inject.mjs --remove`
# deletes it on exit, so a copy in a commit is a leftover, never a source file.
# The four-line mount it pairs with is in `src/routes/__root.tsx`, which is
# tracked and therefore has to come out of the diff by hand.
src/impeccable/

# ESLint's incremental cache, written by `pnpm lint --cache` in CI. A map from
# file content to that file's last result, so an unchanged file is skipped -
# per checkout, and meaningless in another one.
.eslintcache

# Blob reports, written by the sharded unit job in CI (`--reporter=blob`) and by
# anyone reproducing that locally. Merged into a verdict by `test-report` and
# never worth keeping afterwards. Not vitest's default `.vitest-reports`,
# because `upload-artifact` skips a dot-prefixed path as hidden.
unit-blob-reports/
