{
  "name": "planned-travel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply planned-travel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply planned-travel-db --remote",
    "db:migrate:remote:staging": "wrangler d1 migrations apply planned-travel-db-staging --remote --env staging",
    "cf-typegen": "wrangler types",
    "prepare": "husky",
    "sandcastle": "tsx .sandcastle/main.ts",
    "sandcastle:baselines": "tsx .sandcastle/record-baselines.ts",
    "sandcastle:triage": "tsx .sandcastle/triage.ts",
    "sandcastle:architecture": "tsx .sandcastle/architecture-review/architecture-review.ts",
    "sandcastle:sentry": "tsx .sandcastle/sentry-triage/sentry-triage.ts",
    "sandcastle:e2e-smoke": "tsx .sandcastle/e2e-smoke/e2e-smoke.ts"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.12",
    "@sentry/cloudflare": "^10.72.0",
    "@sentry/react": "^10.72.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "^1.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.32.0",
    "maplibre-gl": "^6.4.1",
    "motion": "^13.1.0",
    "nanoid": "^6.0.1",
    "partysocket": "^1.3.0",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@cloudflare/vite-plugin": "^1.26.0",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@playwright/test": "^1.62.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.8.1",
    "react-email": "^6.9.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.70.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
