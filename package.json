{
  "name": "planned-travel",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@10.15.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate-spec-index": "tsx scripts/specs/index.ts",
    "build": "vite build && node scripts/check-server-fn-manifest.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:staging": "CLOUDFLARE_ENV=staging pnpm run deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply planned-travel-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply planned-travel-db --remote",
    "db:migrate:remote:staging": "wrangler d1 migrations apply planned-travel-db-staging --remote --env staging",
    "db:airports:local": "node scripts/seed/airports.mjs --local",
    "db:airports:remote": "node scripts/seed/airports.mjs --remote",
    "db:airports:remote:staging": "node scripts/seed/airports.mjs --remote --env staging",
    "cf-typegen": "wrangler types",
    "worktree:bootstrap": "bash scripts/worktree/bootstrap.sh",
    "prepare": "husky",
    "sentry-triage": "tsx scripts/sentry-triage/sentry-triage.ts",
    "install-skills": "npx -y skills@latest add open-mercato/skills --skill \"*\" -a claude-code -y && npx -y skills@latest update --project -y"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-email/components": "^1.0.12",
    "@sentry/cloudflare": "^10.74.0",
    "@sentry/react": "^10.74.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/react-virtual": "^3.14.11",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.44.0",
    "maplibre-gl": "^6.9.0",
    "motion": "^13.2.0",
    "nanoid": "^6.0.1",
    "partysocket": "^1.3.0",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "vaul": "^1.1.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.35",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "prettier": "^3.8.1",
    "react-email": "^6.9.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
