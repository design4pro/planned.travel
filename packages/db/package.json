{
  "name": "@planned/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "build": "echo 'no build (source-consumed)' && exit 0",
    "generate": "drizzle-kit generate",
    "migrate:local": "wrangler d1 migrations apply planned-travel --local",
    "migrate": "wrangler d1 migrations apply planned-travel --remote"
  },
  "dependencies": {
    "@planned/shared": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.6.3",
    "wrangler": "^4.0.0"
  }
}
