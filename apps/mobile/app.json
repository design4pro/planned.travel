{
  "expo": {
    "name": "planned.travel",
    "slug": "planned-travel",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "plannedtravel",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "travel.planned.app"
    },
    "android": {
      "package": "travel.planned.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store"
    ]
  }
}
