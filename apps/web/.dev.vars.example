# Copy to .dev.vars (local) and set the same via `wrangler secret put` (prod).
# .dev.vars is gitignored.

APP_URL=http://localhost:4321
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# OAuth (Better Auth social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Notifications (Resend). EMAIL_ENABLED=false by default — leave off in dev; the
# NoopEmailSender is used and notifications land in D1 only. Flip to "true" and
# set RESEND_API_KEY (and `wrangler secret put RESEND_API_KEY` in prod) once a
# sending domain is verified in Resend.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=planned.travel <noreply@planned.travel>
