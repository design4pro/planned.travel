{
  "name": "@planned/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:wrangler": "wrangler dev",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e:staging": "playwright test",
    "build:staging": "CLOUDFLARE_ENV=staging vite build && tsc --noEmit",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:staging": "pnpm run build:staging && wrangler deploy",
    "migrate:staging": "wrangler d1 migrations apply planned-travel-staging --remote --config wrangler.jsonc --env staging",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.0.2",
    "@astrojs/react": "^4.2.0",
    "@better-auth/expo": "^1.6.25",
    "@cloudflare/puppeteer": "^1.1.0",
    "@planned/api-client": "workspace:*",
    "@planned/db": "workspace:*",
    "@planned/server": "workspace:*",
    "@planned/shared": "workspace:*",
    "@planned/ui-tokens": "workspace:*",
    "@radix-ui/react-slot": "^1.1.1",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.34",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.4.3",
    "astro": "^5.7.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.14",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.6.0",
    "tailwindcss": "^4.0.0",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^2.1.8",
    "wrangler": "^4.118.0"
  }
}
