---
import Layout from "../layouts/Layout.astro";

const stack = [
  { label: "Astro + Cloudflare Workers", note: "SSR on the edge" },
  { label: "D1 + Drizzle", note: "SQLite, Postgres-portable" },
  { label: "Durable Objects", note: "realtime collaboration" },
  { label: "Workers AI + Vectorize", note: "itinerary gen + semantic search" },
  { label: "Better Auth", note: "Astro + Expo" },
  { label: "MapLibre + Tailwind v4", note: "maps + design system" },
];
---

<Layout>
  <main class="mx-auto max-w-5xl px-6 py-16">
    <header class="mb-12">
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">
        planned.travel
      </p>
      <h1 class="mt-2 text-4xl font-bold sm:text-5xl" style="font-family: var(--font-display)">
        Your trips. Your plan. <span class="text-brand-600">AI-native.</span>
      </h1>
      <p class="mt-4 max-w-2xl text-lg" style="color: var(--color-foreground-muted)">
        A collaborative travel-planning SaaS — generate itineraries with AI, plan on the
        map together in realtime, track budgets, packing, and reservations. Web-first; an
        Expo mobile app follows.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/api/health"
          class="rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-card hover:bg-brand-700"
        >
          Check health
        </a>
        <a
          href="https://github.com/design4pro/planned.travel"
          class="rounded-md border px-4 py-2 text-sm font-semibold hover:bg-[var(--color-surface-muted)]"
          style="border-color: var(--color-border)"
        >
          GitHub
        </a>
      </div>
    </header>

    <section>
      <h2 class="mb-4 text-lg font-semibold">Foundation stack</h2>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          stack.map((s) => (
            <li
              class="rounded-lg border p-4 shadow-card"
              style="border-color: var(--color-border); background: var(--color-surface)"
            >
              <p class="font-semibold">{s.label}</p>
              <p class="text-sm" style="color: var(--color-foreground-muted)">
                {s.note}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <footer class="mt-16 text-sm" style="color: var(--color-foreground-muted)">
      Built on Cloudflare · See <a href="/PLANS.md" class="font-semibold">PLANS.md</a> for the
      roadmap · Reference (not fork): TREK (AGPL-3.0).
    </footer>
  </main>
</Layout>
