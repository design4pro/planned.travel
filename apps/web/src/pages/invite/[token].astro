---
import Layout from "../../layouts/Layout.astro";
import InviteAccept from "../../components/collab/InviteAccept.tsx";
import { getSessionUser } from "../../lib/session";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const user = await getSessionUser(Astro.locals, Astro.request);
const { token } = Astro.params;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t("collab.invite.accept.title")} — planned.travel`}>
  <main class="mx-auto max-w-xl px-6 py-16">
    {token ? (
      <InviteAccept
        client:load
        token={token}
        authed={Boolean(user)}
        labels={{
          title: t("collab.invite.accept.title"),
          subtitle: t("collab.invite.accept.subtitle"),
          as: (role: string) => t("collab.invite.accept.as").replace("{role}", role),
          accept: t("collab.invite.accept.btn"),
          open: t("collab.invite.accept.open"),
          already: t("collab.invite.accept.already"),
          signin: t("collab.invite.accept.signin"),
          error: t("collab.invite.accept.error"),
          generic: t("collab.invite.accept.generic"),
          invalid: t("collab.invite.accept.reason.invalid"),
          revoked: t("collab.invite.accept.reason.revoked"),
          expired: t("collab.invite.accept.reason.expired"),
          exhausted: t("collab.invite.accept.reason.exhausted"),
          roleEditor: t("collab.members.role.editor"),
          roleViewer: t("collab.members.role.viewer"),
        }}
      />
    ) : (
      <p class="text-sm text-muted-foreground">{t("collab.invite.accept.error")}</p>
    )}
  </main>
</Layout>
