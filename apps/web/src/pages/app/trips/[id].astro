---
import Layout from "../../../layouts/Layout.astro";
import SignOutButton from "../../../components/auth/SignOutButton.tsx";
import NotificationBell from "../../../components/notifications/NotificationBell.tsx";
import AddPlace from "../../../components/trips/AddPlace.tsx";
import TripWorkspace from "../../../components/trips/TripWorkspace.tsx";
import TripTabs from "../../../components/trips/TripTabs.astro";
import ExportPdf from "../../../components/trips/ExportPdf.tsx";
import CollabPresence from "../../../components/collab/CollabPresence.tsx";
import MembersPanel from "../../../components/collab/MembersPanel.tsx";
import InviteManager from "../../../components/collab/InviteManager.tsx";
import { getSessionUser } from "../../../lib/session";
import { db } from "../../../lib/db";
import { resolveTripAccess, canEditTrip } from "../../../lib/trip";
import { asc, eq, inArray } from "drizzle-orm";
import { days, dayItems, places } from "@planned/db";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const user = await getSessionUser(Astro.locals, Astro.request);
if (!user) return Astro.redirect("/login");

const { id } = Astro.params;
if (!id) return Astro.redirect("/app");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const database = db(Astro.locals.runtime.env);
const access = await resolveTripAccess(database, id, user.id);
if (!access) return Astro.redirect("/app");
const { trip } = access;
const role = access.role;
const canEdit = canEditTrip(role);

const [dayRows, placeRows] = await Promise.all([
  database.select().from(days).where(eq(days.tripId, trip.id)).orderBy(asc(days.dateIndex)).all(),
  database.select().from(places).where(eq(places.tripId, trip.id)).all(),
]);
const dayIds = dayRows.map((d) => d.id);
const itemRows = dayIds.length
  ? await database
      .select()
      .from(dayItems)
      .where(inArray(dayItems.dayId, dayIds))
      .orderBy(asc(dayItems.orderIndex))
      .all()
  : [];

const itemsByDay = new Map<string, typeof itemRows>();
for (const item of itemRows) {
  const arr = itemsByDay.get(item.dayId) ?? [];
  arr.push(item);
  itemsByDay.set(item.dayId, arr);
}
---

<Layout title={`${trip.title} — planned.travel`}>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <div class="flex items-center justify-between">
      <a href="/app" class="text-sm text-muted-foreground hover:text-primary">
        ← {t("trips.back")}
      </a>
      <div class="flex items-center gap-4">
        <NotificationBell client:load lang={lang} />
        <SignOutButton client:load label={t("nav.signout")} />
      </div>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-3xl font-bold">{trip.title}</h1>
      <ExportPdf
        client:load
        tripId={trip.id}
        label={t("export.pdf")}
        upgrade={t("export.upgrade")}
        unavailable={t("export.unavailable")}
      />
    </div>

    <TripTabs
      tripId={trip.id}
      active="overview"
      labels={{
        overview: t("tabs.overview"),
        costs: t("tabs.costs"),
        reservations: t("tabs.reservations"),
        documents: t("tabs.documents"),
      }}
    />

    {/* Real-time presence + live sync (reload when a collaborator edits). */}
    <div class="mt-4">
      <CollabPresence
        client:load
        tripId={trip.id}
        currentUserId={user.id}
        reloadOn={["plan", "places", "trip", "members"]}
        labels={{
          online: t("collab.presence.online"),
          alone: t("collab.presence.alone"),
        }}
      />
    </div>

    <TripWorkspace
      client:only="react"
      places={placeRows.map((p) => ({ id: p.id, name: p.name, lat: p.lat, lng: p.lng }))}
      days={dayRows.map((day) => ({
        id: day.id,
        dateIndex: day.dateIndex,
        items: (itemsByDay.get(day.id) ?? []).map((item) => ({
          id: item.id,
          placeId: item.placeId,
          note: item.note,
        })),
      }))}
      labels={{
        map: t("planner.map"),
        itinerary: t("planner.itinerary"),
        showItinerary: t("planner.showItinerary"),
        hideItinerary: t("planner.hideItinerary"),
        day: t("planner.day"),
        empty: t("planner.empty"),
        emptyMap: t("planner.emptyMap"),
        place: t("planner.place"),
      }}
    />

    <div class="mt-8">
      {canEdit ? (
        <AddPlace
          client:load
          tripId={trip.id}
          labels={{
            title: t("planner.addPlace.title"),
            name: t("planner.name"),
            lat: t("planner.lat"),
            lng: t("planner.lng"),
            add: t("planner.add"),
            error: t("planner.error"),
          }}
        />
      ) : (
        <p class="rounded-lg border bg-card p-3 text-sm text-muted-foreground">
          {t("collab.readonly")}
        </p>
      )}
    </div>

    {/* Owner only: manage collaborators + invite links. */}
    {
      role === "owner" && (
        <section class="mt-8 space-y-4">
          <MembersPanel
            client:load
            tripId={trip.id}
            currentUserId={user.id}
            labels={{
              title: t("collab.members.title"),
              roleOwner: t("collab.members.role.owner"),
              roleEditor: t("collab.members.role.editor"),
              roleViewer: t("collab.members.role.viewer"),
              you: t("collab.members.you"),
              remove: t("collab.members.remove"),
              removed: t("collab.members.removed"),
              roleSaved: t("collab.members.roleSaved"),
            }}
          />
          <InviteManager
            client:load
            tripId={trip.id}
            labels={{
              title: t("collab.invite.title"),
              role: t("collab.invite.role"),
              roleEditor: t("collab.members.role.editor"),
              roleViewer: t("collab.members.role.viewer"),
              expiry: t("collab.invite.expiry"),
              expiryNever: t("collab.invite.expiry.never"),
              expiryDays: (n: number) => t("collab.invite.expiry.days").replace("{n}", String(n)),
              maxUses: t("collab.invite.maxUses"),
              maxUsesAny: t("collab.invite.maxUses.any"),
              maxUsesN: (n: number) => t("collab.invite.maxUses.n").replace("{n}", String(n)),
              create: t("collab.invite.create"),
              empty: t("collab.invite.empty"),
              copy: t("collab.invite.copy"),
              copied: t("collab.invite.copied"),
              revoke: t("collab.invite.revoke"),
              revoked: t("collab.invite.revoked"),
              statusOpen: t("collab.invite.status.open"),
              statusUsed: t("collab.invite.status.used"),
              statusExpired: t("collab.invite.status.expired"),
              statusRevoked: t("collab.invite.status.revoked"),
              uses: (used: number) => t("collab.invite.uses").replace("{used}", String(used)),
            }}
          />
        </section>
      )
    }

  </main>
</Layout>
