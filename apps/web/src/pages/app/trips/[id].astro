---
import Layout from "../../../layouts/Layout.astro";
import SignOutButton from "../../../components/auth/SignOutButton.tsx";
import AddPlace from "../../../components/trips/AddPlace.tsx";
import TripMap from "../../../components/trips/TripMap.tsx";
import TripTabs from "../../../components/trips/TripTabs.astro";
import ExportPdf from "../../../components/trips/ExportPdf.tsx";
import { getSessionUser } from "../../../lib/session";
import { db } from "../../../lib/db";
import { resolveTripAccess, canEditTrip } from "../../../lib/trip";
import { asc, eq, inArray } from "drizzle-orm";
import { days, dayItems, places } from "@planned/db";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const user = await getSessionUser(Astro.locals, Astro.request);
if (!user) return Astro.redirect("/login");

const { id } = Astro.params;
if (!id) return Astro.redirect("/app");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const database = db(Astro.locals.runtime.env);
const access = await resolveTripAccess(database, id, user.id);
if (!access) return Astro.redirect("/app");
const { trip } = access;
const role = access.role;
const canEdit = canEditTrip(role);

const [dayRows, placeRows] = await Promise.all([
  database.select().from(days).where(eq(days.tripId, trip.id)).orderBy(asc(days.dateIndex)).all(),
  database.select().from(places).where(eq(places.tripId, trip.id)).all(),
]);
const dayIds = dayRows.map((d) => d.id);
const itemRows = dayIds.length
  ? await database
      .select()
      .from(dayItems)
      .where(inArray(dayItems.dayId, dayIds))
      .orderBy(asc(dayItems.orderIndex))
      .all()
  : [];

const placesById = new Map(placeRows.map((p) => [p.id, p]));
const itemsByDay = new Map<string, typeof itemRows>();
for (const item of itemRows) {
  const arr = itemsByDay.get(item.dayId) ?? [];
  arr.push(item);
  itemsByDay.set(item.dayId, arr);
}
---

<Layout title={`${trip.title} — planned.travel`}>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <div class="flex items-center justify-between">
      <a href="/app" class="text-sm text-muted-foreground hover:text-primary">
        ← {t("trips.back")}
      </a>
      <SignOutButton client:load label={t("nav.signout")} />
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-3xl font-bold">{trip.title}</h1>
      <ExportPdf
        client:load
        tripId={trip.id}
        label={t("export.pdf")}
        upgrade={t("export.upgrade")}
        unavailable={t("export.unavailable")}
      />
    </div>

    <TripTabs
      tripId={trip.id}
      active="overview"
      labels={{
        overview: t("tabs.overview"),
        costs: t("tabs.costs"),
        reservations: t("tabs.reservations"),
        documents: t("tabs.documents"),
      }}
    />

    {
      placeRows.length > 0 && (
        <div class="mt-6">
          <TripMap
            client:only="react"
            places={placeRows.map((p) => ({
              id: p.id,
              name: p.name,
              lat: p.lat,
              lng: p.lng,
            }))}
          />
        </div>
      )
    }

    <div class="mt-8">
      {canEdit ? (
        <AddPlace
          client:load
          tripId={trip.id}
          labels={{
            title: t("planner.addPlace.title"),
            name: t("planner.name"),
            lat: t("planner.lat"),
            lng: t("planner.lng"),
            add: t("planner.add"),
            error: t("planner.error"),
          }}
        />
      ) : (
        <p class="rounded-lg border bg-card p-3 text-sm text-muted-foreground">
          {t("collab.readonly")}
        </p>
      )}
    </div>

    <section class="mt-8 space-y-6">
    {
      dayRows.length === 0 ? (
        <p class="text-sm text-muted-foreground">{t("planner.empty")}</p>
      ) : (
        dayRows.map((day, i) => (
          <div class="rounded-lg border bg-card p-4 shadow-card">
            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide text-muted-foreground">
              {t("planner.day")} {i + 1}
            </h2>
            {(itemsByDay.get(day.id) ?? []).length === 0 ? (
              <p class="text-sm text-muted-foreground">{t("planner.empty")}</p>
            ) : (
              <ul class="space-y-2">
                {(itemsByDay.get(day.id) ?? []).map((item) => {
                  const place = item.placeId ? placesById.get(item.placeId) : null;
                  return (
                    <li class="flex items-center gap-2 text-sm">
                      <span class="text-muted-foreground">•</span>
                      {place ? (
                        <span>
                          {place.name}
                          <span class="ml-2 text-xs text-muted-foreground">
                            {place.lat.toFixed(3)}, {place.lng.toFixed(3)}
                          </span>
                        </span>
                      ) : (
                        <span>{item.note}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            )}
          </div>
        ))
      )
    }
    </section>
  </main>
</Layout>
