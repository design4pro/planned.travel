---
import Layout from "../../../../layouts/Layout.astro";
import SignOutButton from "../../../../components/auth/SignOutButton.tsx";
import TripTabs from "../../../../components/trips/TripTabs.astro";
import ExpenseForm, {
  type MemberOption,
} from "../../../../components/costs/ExpenseForm.tsx";
import ExpenseList from "../../../../components/costs/ExpenseList.tsx";
import MemberAdd from "../../../../components/costs/MemberAdd.tsx";
import CollabPresence from "../../../../components/collab/CollabPresence.tsx";
import { getSessionUser } from "../../../../lib/session";
import { db } from "../../../../lib/db";
import { resolveTripAccess, canEditTrip } from "../../../../lib/trip";
import { and, asc, desc, eq, inArray } from "drizzle-orm";
import { expenses, expenseSplits, tripMembers } from "@planned/db";
import { summarizeByCurrency, formatMoney, fillSettlement } from "@planned/shared";
import { getLangFromUrl, useTranslations } from "../../../../i18n/utils";

const user = await getSessionUser(Astro.locals, Astro.request);
if (!user) return Astro.redirect("/login");

const { id } = Astro.params;
if (!id) return Astro.redirect("/app");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const env = Astro.locals.runtime.env;
const database = db(env);
const access = await resolveTripAccess(database, id, user.id);
if (!access) return Astro.redirect("/app");
const { trip } = access;
const role = access.role;
const canEdit = canEditTrip(role);
const isOwner = role === "owner";

// Ensure the owner has a trip_member row (legacy trips may predate this invariant).
if (isOwner) {
  const [ownerMember] = await database
    .select()
    .from(tripMembers)
    .where(and(eq(tripMembers.tripId, trip.id), eq(tripMembers.userId, user.id)))
    .limit(1);
  if (!ownerMember) {
    await database.insert(tripMembers).values({ tripId: trip.id, userId: user.id, role: "owner" });
  }
}

const [memberRows, expenseRows] = await Promise.all([
  database.select().from(tripMembers).where(eq(tripMembers.tripId, trip.id)).orderBy(asc(tripMembers.createdAt)).all(),
  database.select().from(expenses).where(eq(expenses.tripId, trip.id)).orderBy(desc(expenses.createdAt)).all(),
]);

const userIds = [...new Set([trip.ownerId, ...memberRows.map((m) => m.userId)])];
const userPlaceholders = userIds.map(() => "?").join(",");
const { results: userResults } = userIds.length
  ? await env.DB.prepare(`SELECT id, name, email FROM "user" WHERE id IN (${userPlaceholders})`)
      .bind(...userIds)
      .all<{ id: string; name: string | null; email: string }>()
  : { results: [] };
const usersById = new Map((userResults ?? []).map((u) => [u.id, u]));

const expenseIds = expenseRows.map((e) => e.id);
const splitRows = expenseIds.length
  ? await database.select().from(expenseSplits).where(inArray(expenseSplits.expenseId, expenseIds)).all()
  : [];
const splitsByExpense = new Map<string, { userId: string; shareCents: number }[]>();
for (const s of splitRows) {
  const arr = splitsByExpense.get(s.expenseId) ?? [];
  arr.push({ userId: s.userId, shareCents: s.shareCents });
  splitsByExpense.set(s.expenseId, arr);
}

const membersForSummary = memberRows.map((m) => ({ userId: m.userId }));
const expensesForSummary = expenseRows.map((e) => ({
  id: e.id,
  paidByUserId: e.paidByUserId,
  amountCents: e.amountCents,
  currency: e.currency,
  category: e.category,
  description: e.description,
  date: e.date ?? null,
  splits: splitsByExpense.get(e.id) ?? [],
}));

const summaries = summarizeByCurrency(membersForSummary, expensesForSummary);

const displayName = (uid: string) =>
  uid === user.id ? t("costs.you") : usersById.get(uid)?.name ?? usersById.get(uid)?.email ?? uid.slice(0, 6);

const memberOptions: MemberOption[] = memberRows.map((m) => ({
  userId: m.userId,
  name: usersById.get(m.userId)?.name ?? null,
  email: usersById.get(m.userId)?.email ?? null,
}));

const expenseListRows = expenseRows.map((e) => ({
  id: e.id,
  paidByUserId: e.paidByUserId,
  paidByName: usersById.get(e.paidByUserId)?.name ?? usersById.get(e.paidByUserId)?.email ?? null,
  amountCents: e.amountCents,
  currency: e.currency,
  category: e.category,
  description: e.description,
}));

const categoryLabels = {
  food: t("costs.cat.food"),
  lodging: t("costs.cat.lodging"),
  transport: t("costs.cat.transport"),
  activities: t("costs.cat.activities"),
  shopping: t("costs.cat.shopping"),
  other: t("costs.cat.other"),
};
---

<Layout title={`${trip.title} — ${t("costs.heading")} — planned.travel`}>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <div class="flex items-center justify-between">
      <a href={`/app/trips/${trip.id}`} class="text-sm text-muted-foreground hover:text-primary">
        ← {trip.title}
      </a>
      <SignOutButton client:load label={t("nav.signout")} />
    </div>

    <TripTabs
      tripId={trip.id}
      active="costs"
      labels={{
        overview: t("tabs.overview"),
        costs: t("tabs.costs"),
        reservations: t("tabs.reservations"),
        documents: t("tabs.documents"),
      }}
    />

    <h1 class="mt-6 text-3xl font-bold">{t("costs.heading")}</h1>

    <div class="mt-3">
      <CollabPresence
        client:load
        tripId={trip.id}
        currentUserId={user.id}
        reloadOn={["expenses", "members"]}
        labels={{
          online: t("collab.presence.online"),
          alone: t("collab.presence.alone"),
        }}
      />
    </div>

    {/* Participants */}
    <section class="mt-8">
      <h2 class="mb-2 text-sm font-semibold uppercase tracking-wide text-muted-foreground">
        {t("costs.members")} ({memberRows.length})
      </h2>
      <div class="flex flex-wrap gap-2">
        {memberOptions.map((m) => (
          <span class="rounded-full border bg-card px-3 py-1 text-sm">
            {m.userId === user.id ? t("costs.you") : m.name ?? m.email ?? m.userId.slice(0, 6)}
          </span>
        ))}
      </div>
      <div class="mt-3">
        {isOwner && (
          <MemberAdd
            client:load
            tripId={trip.id}
            labels={{
              title: t("costs.addMember.title"),
              email: t("costs.addMember.email"),
              add: t("costs.addMember.btn"),
              error: t("costs.addMember.error"),
            }}
          />
        )}
      </div>
    </section>

    {/* Totals + settle-up per currency */}
    <section class="mt-8 space-y-4">
      {
        summaries.length === 0 ? (
          <p class="text-sm text-muted-foreground">{t("costs.empty")}</p>
        ) : (
          summaries.map((s) => (
            <div class="rounded-lg border bg-card p-4 shadow-card">
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">
                  {s.currency}
                </h3>
                <span class="text-sm text-muted-foreground">
                  {t("costs.total")}:{" "}
                  <span class="font-semibold text-foreground">{formatMoney(s.totalCents, s.currency, lang)}</span>
                </span>
              </div>

              {s.settlements.length === 0 ? (
                <p class="mt-3 text-sm text-muted-foreground">{t("costs.settled")}</p>
              ) : (
                <ul class="mt-3 space-y-1">
                  {s.settlements.map((st) => (
                    <li class="text-sm">
                      {fillSettlement(
                        t("costs.owes"),
                        displayName(st.fromUserId),
                        displayName(st.toUserId),
                      )}{" "}
                      <span class="font-semibold tabular-nums">{formatMoney(st.amountCents, s.currency, lang)}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        )
      }
    </section>

    {/* Add expense */}
    <section class="mt-8">
      {canEdit ? (
        <ExpenseForm
          client:load
          tripId={trip.id}
          members={memberOptions}
          currentUserId={user.id}
          labels={{
            title: t("costs.add.title"),
            amount: t("costs.amount"),
            currency: t("costs.currency"),
            category: t("costs.category"),
            description: t("costs.description"),
            participants: t("costs.participants"),
            all: t("costs.all"),
            you: t("costs.you"),
            add: t("costs.add"),
            error: t("costs.error"),
            categories: categoryLabels,
          }}
        />
      ) : (
        <p class="rounded-lg border bg-card p-3 text-sm text-muted-foreground">{t("collab.readonly")}</p>
      )}
    </section>

    {/* Expense list */}
    <section class="mt-6">
      <ExpenseList
        client:load
        expenses={expenseListRows}
        currentUserId={user.id}
        lang={lang}
        labels={{
          paidBy: t("costs.paidBy"),
          you: t("costs.you"),
          delete: t("costs.delete"),
          deleted: t("costs.deleted"),
          empty: t("costs.empty"),
          categories: categoryLabels,
        }}
      />
    </section>
  </main>
</Layout>
