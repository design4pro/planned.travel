---
import Layout from "../../layouts/Layout.astro";
import SignOutButton from "../../components/auth/SignOutButton.tsx";
import CreateTrip from "../../components/trips/CreateTrip.tsx";
import { getSessionUser } from "../../lib/session";
import { db } from "../../lib/db";
import { desc, eq } from "drizzle-orm";
import { trips, tripMembers } from "@planned/db";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const user = await getSessionUser(Astro.locals, Astro.request);
if (!user) return Astro.redirect("/login");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const database = db(Astro.locals.runtime.env);
// Trips the user owns OR is a member of (editor/viewer) — shared trips appear
// alongside owned ones, mirroring GET /api/trips.
const [owned, memberRows] = await Promise.all([
  database.select().from(trips).where(eq(trips.ownerId, user.id)).orderBy(desc(trips.updatedAt)).all(),
  database
    .select({ trip: trips, role: tripMembers.role })
    .from(tripMembers)
    .innerJoin(trips, eq(trips.id, tripMembers.tripId))
    .where(eq(tripMembers.userId, user.id))
    .all(),
]);
const myTrips = [
  ...owned.map((tr) => ({ ...tr, role: "owner" })),
  ...memberRows
    .filter((r) => r.trip.ownerId !== user.id)
    .map((r) => ({ ...r.trip, role: r.role })),
];
---

<Layout title="planned.travel — app">
  <main class="mx-auto max-w-5xl px-6 py-12">
    <header class="flex items-center justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">
          planned.travel
        </p>
        <h1 class="text-2xl font-bold">{user.email}</h1>
      </div>
      <div class="flex items-center gap-4">
        <a href="/app/account" class="text-sm font-medium text-primary hover:underline">
          {t("account.title")}
        </a>
        <SignOutButton client:load label={t("nav.signout")} />
      </div>
    </header>

    <section class="mt-10">
      <h2 class="mb-3 text-lg font-semibold">{t("trips.heading")}</h2>
      <CreateTrip
        client:load
        label={t("trips.create.label")}
        placeholder={t("trips.create.placeholder")}
        btn={t("trips.create.btn")}
        quotaError={t("billing.quota").replace("{limit}", "3")}
        upgradeLabel={t("billing.upgrade")}
        pricingHref="/pricing"
      />

      {
        myTrips.length === 0 ? (
          <p class="mt-6 text-sm text-muted-foreground">{t("trips.empty")}</p>
        ) : (
          <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
            {myTrips.map((trip) => (
              <li>
                <a
                  href={`/app/trips/${trip.id}`}
                  class="block rounded-lg border p-4 shadow-card bg-card hover:border-primary transition-colors"
                >
                  <div class="flex items-center justify-between gap-2">
                    <p class="font-semibold">{trip.title}</p>
                    {trip.role !== "owner" && (
                      <span class="rounded-full bg-primary/10 px-2 py-0.5 text-xs font-medium text-primary">
                        {trip.role === "viewer"
                          ? t("collab.members.role.viewer")
                          : t("collab.members.role.editor")}
                      </span>
                    )}
                  </div>
                  <p class="mt-1 text-xs text-muted-foreground">
                    {new Date(trip.updatedAt).toLocaleDateString()}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Layout>
