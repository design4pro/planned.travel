---
import Layout from "../../layouts/Layout.astro";
import NotificationInbox from "../../components/notifications/NotificationInbox.tsx";
import NotificationBell from "../../components/notifications/NotificationBell.tsx";
import SignOutButton from "../../components/auth/SignOutButton.tsx";
import { getSessionUser } from "../../lib/session";
import { db } from "../../lib/db";
import { listNotifications } from "../../lib/notifications";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const user = await getSessionUser(Astro.locals, Astro.request);
if (!user) return Astro.redirect("/login");

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const database = db(Astro.locals.runtime.env);
// Server-render the newest 100 so the inbox hydrates with data (no flash).
const initial = await listNotifications(database, user.id, { limit: 100 });
---
<Layout title={`planned.travel — ${t("notifications.title")}`}>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <header class="flex items-center justify-between">
      <div>
        <a href="/app" class="text-sm text-muted-foreground hover:text-primary">← {t("trips.back")}</a>
        <h1 class="mt-1 text-2xl font-bold">{t("notifications.title")}</h1>
      </div>
      <div class="flex items-center gap-4">
        <NotificationBell client:load lang={lang} />
        <SignOutButton client:load label={t("nav.signout")} />
      </div>
    </header>

    <NotificationInbox client:load lang={lang} initial={initial} />
  </main>
</Layout>
