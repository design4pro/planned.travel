---
import Layout from "../layouts/Layout.astro";
import AuthForm from "../components/auth/AuthForm.tsx";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { localizePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const env = Astro.locals.runtime.env;

const social = [env.GOOGLE_CLIENT_ID && "google", env.APPLE_CLIENT_ID && "apple"].filter(
  Boolean
) as string[];
---

<Layout title={`${t("auth.signup.title")} — planned.travel`}>
  <main class="mx-auto max-w-sm px-6 py-16">
    <h1 class="text-2xl font-bold">{t("auth.signup.title")}</h1>
    <p class="mt-1 text-sm text-muted-foreground">{t("auth.signup.subtitle")}</p>

    <div class="mt-6">
      <AuthForm
        client:load
        mode="signup"
        social={social}
        labels={{
          email: t("auth.email"),
          password: t("auth.password"),
          submit: t("auth.signup.btn"),
          or: t("auth.or"),
          genericError: t("auth.error.generic"),
        }}
      />
    </div>

    <p class="mt-6 text-center text-sm text-muted-foreground">
      {t("auth.hasAccount")}
      <a href={localizePath("/login", lang)} class="px-1 font-semibold">{t("auth.signin.btn")}</a>
    </p>
  </main>
</Layout>
