[
  {
    "name": "Autopilot new pull requests",
    "description": "Candidate definition only. Enable separately after the ownership cutover and automation audit.",
    "events": [
      "pull_request.opened"
    ],
    "intervalSeconds": 300,
    "filters": {
      "authors": [
        "rafalwolak"
      ],
      "excludeLabels": [
        "in-progress",
        "review",
        "changes-requested",
        "merge-queue",
        "qa",
        "qa-failed",
        "blocked",
        "do-not-merge",
        "ci-monitoring"
      ],
      "lookbackDays": 7,
      "maxRecords": 25
    },
    "task": {
      "prompt": "{{github.number}}",
      "workflow": "pr-autopilot",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    },
    "enabled": false
  },
  {
    "name": "Merge reviewed agent pull requests",
    "description": "Candidate definition only. Enable separately after the ownership cutover and automation audit.",
    "events": [
      "pull_request.reviewed"
    ],
    "intervalSeconds": 300,
    "filters": {
      "authors": [
        "rafalwolak"
      ],
      "anyLabels": [
        "merge-queue"
      ],
      "excludeLabels": [
        "in-progress",
        "changes-requested",
        "qa",
        "qa-failed",
        "blocked",
        "do-not-merge"
      ],
      "lookbackDays": 7,
      "maxRecords": 25
    },
    "task": {
      "prompt": "{{github.number}}",
      "workflow": "pr-autopilot",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    },
    "enabled": false
  },
  {
    "name": "Weekly lessons",
    "description": "Candidate definition only. Enable separately after the ownership cutover and automation audit.",
    "kind": "schedule",
    "schedule": {
      "type": "weekly",
      "day": 5,
      "hour": 16,
      "minute": 0
    },
    "task": {
      "prompt": "Run the om-pipeline-retro skill for {{project}} on {{date}}.",
      "workflow": "lessons",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    },
    "enabled": false
  },
  {
    "name": "Weekly skills update",
    "description": "Candidate definition only. Enable separately after the ownership cutover and automation audit.",
    "enabled": false,
    "kind": "schedule",
    "schedule": {
      "type": "weekly",
      "day": 2,
      "hour": 5,
      "minute": 0
    },
    "task": {
      "prompt": "Run skills-update for {{project}} on {{date}}.",
      "workflow": "skills-update",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    }
  },
  {
    "name": "Weekly context rotation",
    "description": "Candidate definition only. Enable separately after the ownership cutover and automation audit.",
    "enabled": false,
    "kind": "schedule",
    "schedule": {
      "type": "weekly",
      "day": 0,
      "hour": 4,
      "minute": 0
    },
    "task": {
      "prompt": "Run context-maintenance for {{project}} on {{date}}.",
      "workflow": "context-maintenance",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    }
  }
]
