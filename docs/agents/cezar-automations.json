[
  {
    "name": "issue-groom",
    "description": "Every new issue gets SDLC labels, a Definition of Ready check and implementation notes from om-auto-manage-issues (ADR 0018). Issues a run holds or a human put on hold never match.",
    "events": ["issue.opened"],
    "intervalSeconds": 120,
    "filters": {
      "excludeLabels": ["in-progress", "blocked", "do-not-close"],
      "lookbackDays": 3,
      "maxRecords": 10
    },
    "task": {
      "prompt": "{{github.number}}",
      "workflow": "issue-groom",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    }
  },
  {
    "name": "issue-regroom",
    "description": "A human adds `groom` to re-run om-auto-manage-issues on one issue (after an edit, a reply, a relabel). The override removes the label first.",
    "events": ["issue.labeled"],
    "intervalSeconds": 120,
    "filters": {
      "changedLabels": ["groom"],
      "excludeLabels": ["in-progress"],
      "lookbackDays": 3,
      "maxRecords": 10
    },
    "task": {
      "prompt": "{{github.number}}",
      "workflow": "issue-groom",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    }
  },
  {
    "name": "issue-autofix",
    "description": "A human adds `autofix`; om-auto-fix-issue drives the issue to a reviewed PR on develop (ADR 0018). Held, blocked, do-not-merge or spec-pending issues never match.",
    "events": ["issue.labeled"],
    "intervalSeconds": 60,
    "filters": {
      "changedLabels": ["autofix"],
      "excludeLabels": ["in-progress", "blocked", "do-not-merge", "spec"],
      "lookbackDays": 3,
      "maxRecords": 5
    },
    "task": {
      "prompt": "{{github.number}}",
      "workflow": "issue-autofix",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    }
  },
  {
    "name": "issue-spec",
    "description": "A human adds `spec` to a `feature` issue; om-auto-write-spec lands .ai/specs/<date>-<slug>.md on a design-only PR (ADR 0018).",
    "events": ["issue.labeled"],
    "intervalSeconds": 60,
    "filters": {
      "changedLabels": ["spec"],
      "allLabels": ["feature"],
      "excludeLabels": ["in-progress", "blocked"],
      "lookbackDays": 3,
      "maxRecords": 5
    },
    "task": {
      "prompt": "{{github.number}}",
      "workflow": "spec",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    }
  },
  {
    "name": "pr-autopilot",
    "description": "A human maintainer opens a PR; om-pr-autopilot diagnoses and runs the right chain, never merges (ADR 0018). Agent PRs (planned-travel-agent) and dependabot are excluded by author; pipeline labels exclude the race with om-open-pr.",
    "events": ["pull_request.opened"],
    "intervalSeconds": 300,
    "filters": {
      "authors": ["rafalwolak"],
      "excludeLabels": [
        "in-progress",
        "review",
        "changes-requested",
        "merge-queue",
        "qa",
        "qa-failed",
        "blocked",
        "do-not-merge",
        "ci-monitoring"
      ],
      "lookbackDays": 3,
      "maxRecords": 5
    },
    "task": {
      "prompt": "{{github.number}}",
      "workflow": "pr-autopilot",
      "autonomous": true,
      "worktree": true,
      "variants": 1,
      "generateFollowups": false
    }
  }
]
