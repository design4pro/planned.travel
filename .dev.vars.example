# planned.travel — local secrets template
#
# Copy to `.dev.vars` and fill in. `vite dev` loads this file into the Worker's
# `env` through Miniflare, exactly as `wrangler secret put` does in production.
# `.dev.vars` is gitignored; this file must never contain a real value.
#
# This is the complete secret list docs/SPEC.md §5 and docs/ARCHITECTURE.md
# §3 both promise lives here. The two superseded STRIPE_* names are the one
# deliberate omission: the shipped billing code still reads them, but they are
# on their way out, and docs/DEPLOY.md §6 is where they are set until phase A
# retires them. Apart from that pair, every secret the Worker reads is below.
# The Worker also reads names that are not secrets, and those are the next
# paragraph's subject rather than an omission from this one.
#
# Non-secret configuration (LOG_LEVEL, EMAIL_FROM, FILES_PUBLIC_BASE, …) is
# NOT here — it lives in the `vars` block of `wrangler.jsonc` and is checked
# in. Three names below break that rule deliberately, and each argues the
# exception in its own comment rather than leaving it silent: the billing
# environment switch, and the two local overrides in the last section.
#
# A `.dev.vars.<environment>` file replaces this one wholesale instead of
# merging with it, so a staging variant has to redeclare every name below.
#
# In production every name below is set with:
#   wrangler secret put <NAME>            # add --env staging for staging
# List what is currently set with:
#   wrangler secret list


# ── Auth (required) ──────────────────────────────────────────────────────────

# Signs session cookies and Better Auth tokens. Rotating it logs everyone out.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=


# ── Social sign-in (optional; each provider is skipped when unset) ───────────

# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Developer → Certificates, Identifiers & Profiles → Services ID.
# APPLE_CLIENT_SECRET is the ES256 client-secret JWT, not the .p8 key itself.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Only needed when a native iOS client signs in against this backend.
APPLE_APP_BUNDLE_IDENTIFIER=


# ── Billing (optional until phase A; nothing reads these before it) ──────────

# Polar dashboard → Settings → Developers → New Token. Scope it to exactly
# checkouts:write, customer_sessions:write, orders:read, subscriptions:read,
# subscriptions:write, products:read, webhooks:write, webhooks:read — the token
# is presented as polar_oat_… and can issue refunds, so it stays server-side.
POLAR_ACCESS_TOKEN=

# Signing secret of the billing webhook endpoint. Which of the two creation
# paths you used decides where this value comes from, and only one of them
# lets you choose it. `POST /v1/webhooks/endpoints` takes no `secret` field:
# Polar generates one and returns it on the 201, so you copy it out of the
# response. The dashboard → Settings → Webhooks → Add endpoint form is the
# path that lets you supply your own — its "Set a secret" step, in Polar's
# words, "you can set your own or generate a random one" — so mint the value
# first (openssl rand -base64 32) and create the endpoint there if you want
# this secret set before the endpoint exists. Afterwards neither path can
# assign one: PATCH /v1/webhooks/endpoints/{id}/secret takes no request body
# and only regenerates, and the old value stops verifying the moment it
# returns. Verified against Polar 2026-08-22; docs/DEPLOY.md §9.4 has the
# citations and the redeploy window.
POLAR_WEBHOOK_SECRET=

# `sandbox` or `production`, nothing else and no default. This one is not a
# credential, so it is the exception to the header rule above: sandbox and
# production are separate Polar accounts, and keeping the environment selector
# in the same file as the token it pairs with is what stops the two drifting
# apart. Argued in docs/SPEC.md §5; base URLs in docs/DEPLOY.md §9.3.
POLAR_SERVER=

# Nothing above is read yet: until phase A the live checkout is still
# `src/server/billing/stripe.ts`, which reads the two superseded STRIPE_*
# secrets this file no longer lists, together with the four build-time price
# ids they pair with in `src/lib/plans.ts`. Take the secret pair from
# docs/DEPLOY.md §6 if paid plans must work today; the four price ids are
# named in the build-time section near the bottom of this file. Set the three
# names above now so the cutover is a deploy rather than a scramble.


# ── Transactional email (optional; queued mail fails loudly without it) ──────

# Resend-compatible REST key. The endpoint itself is the EMAIL_API_URL var.
EMAIL_API_KEY=


# ── Nightly D1 backup to R2 (optional; the cron logs and skips without it) ───

# Cloudflare dashboard → Workers & Pages → Account details → Account ID.
CLOUDFLARE_ACCOUNT_ID=
# Scoped API token with `D1:read` on this account only.
CLOUDFLARE_API_TOKEN=
# UUID of the D1 database to export — the `database_id` in wrangler.jsonc.
D1_DATABASE_ID=


# ── PDF itinerary export (optional; falls back to an HTML export) ────────────

# API token with `Browser Rendering:edit`. Needs CLOUDFLARE_ACCOUNT_ID too.
BROWSER_RENDERING_API_TOKEN=


# ── Catalogue scrape (optional; the weekly cron logs and skips without it) ───

# https://www.firecrawl.dev → account → API keys. Bearer token for the scrape
# and crawl calls behind the catalogue pipeline, used from queue handlers only.
FIRECRAWL_API_KEY=

# Firecrawl account settings → Advanced tab. It is one account-wide value, not
# one per endpoint: the same secret signs every delivery to every URL on the
# account. Set it whenever the key above is set — a key without a secret is
# the expensive combination, since the crawl is billed and then rejected.
FIRECRAWL_WEBHOOK_SECRET=


# ── MCP staff tokens (optional; the agent surface stays off without it) ──────

# HMAC-SHA256 key over a staff token's raw UTF-8 bytes; the digest is stored
# as lowercase hex in `staff_api_tokens`, so the console and the MCP server
# compute the same value and neither side has a fallback. Rotating it
# invalidates every issued staff token at once, the way rotating
# BETTER_AUTH_SECRET logs everyone out. See docs/DEPLOY.md §14.3.
# Generate: openssl rand -base64 32
MCP_TOKEN_PEPPER=


# ── Build-time public values — NOT part of this file ─────────────────────────
#
# Price and product ids are inlined into both bundles by Vite, so they are read
# from `import.meta.env`, not from the Worker environment. Put them in
# `.env.local` (also gitignored) for local work, and in repository *variables*
# for CI, since neither kind of id is secret. There are two sets, and only the
# first one is live:
#
#   # CURRENT — read today by `src/lib/plans.ts`, and passed into the build by
#   # both .github/workflows/ci.yml and .github/workflows/deploy.yml. Leave one
#   # empty and that plan's checkout throws instead of opening, so the pricing
#   # page renders with nothing anyone can actually buy.
#   VITE_STRIPE_PRICE_SOLO_MONTHLY=price_…
#   VITE_STRIPE_PRICE_SOLO_YEARLY=price_…
#   VITE_STRIPE_PRICE_CREW_MONTHLY=price_…
#   VITE_STRIPE_PRICE_CREW_YEARLY=price_…
#
#   # PHASE A — the four that replace them, one per product of the Polar
#   # organization. Nothing reads these yet; set them with the cutover.
#   VITE_POLAR_PRODUCT_SOLO_MONTHLY=…
#   VITE_POLAR_PRODUCT_SOLO_YEARLY=…
#   VITE_POLAR_PRODUCT_CREW_MONTHLY=…
#   VITE_POLAR_PRODUCT_CREW_YEARLY=…
#
# The swap is all-or-nothing: one module resolves the purchasable price, so a
# build carrying both sets would offer two prices for the same plan. Move the
# module, both workflow files and this block together — docs/DEPLOY.md §10 owns
# that change and enumerates what else moves with it.
#
# Sandbox and production are separate Polar accounts, so the four product ids
# are different values in the two places: `.env.local` carries the sandbox ids
# and CI carries the production ones. A sandbox id in a production build does
# not fail loudly — it opens a checkout for a product that account does not
# have.
#
# `.env.local` is the right home only because Vite, not the Worker, reads these
# at build time. Never move a name from the sections above into it: while a
# `.dev.vars` file exists, Cloudflare loads no `.env` file into the Worker's
# `env`, so the value would be silently undefined at runtime with no error.


# ── Local non-secret overrides (optional; wrangler.jsonc vars win otherwise) ─

# Local dev origin — overrides the production APP_URL in wrangler.jsonc vars.
# The port must be the one `pnpm dev` binds, which is 3000 (`vite dev --port
# 3000` in package.json), and 3000 is also what `appUrl()` in
# `src/server/auth/env.ts` falls back to when this name is unset. Every auth URL
# is built from this value, so a port nothing is listening on does not fail
# loudly — it sends the OAuth callback, the verification link in an email and
# the PDF-export link to a dead origin. If you deliberately run the dev server
# on another port, change both this line and the redirect URI registered with
# each social provider above.
APP_URL=http://localhost:3000

# Local basemap archive — overrides the dated production TILES_ARCHIVE_KEY in
# wrangler.jsonc vars. Deployments version that key and never overwrite it, but
# a local miniflare bucket only holds whatever you put there with `wrangler r2
# object put planned-travel-tiles/<key> --file=… --local`, so name that object
# here rather than renaming it. See docs/DEPLOY.md §7.4.
TILES_ARCHIVE_KEY=basemaps/planet.pmtiles
