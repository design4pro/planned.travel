{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Project-scoped Claude Code settings for planned.travel. deny holds the few operations nothing recovers from - secrets, generated files, history rewrites, deleted Cloudflare stores - and applies in every session. ask holds what a developer approves at the keyboard; a cezar run uses --permission-mode dontAsk, so there it is refused (ADR 0030). The allow list carries only the tracker operations the om-* pipeline cannot run without, plus the read-only queries it runs constantly. Every other permission rule stays per-developer in the gitignored .claude/settings.local.json.",
  "permissions": {
    "allow": [
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh run view:*)",
      "Bash(gh issue:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh label list:*)",
      "Bash(gh search:*)",
      "Bash(node .ai/scripts/backlog-status.mjs:*)"
    ],
    "ask": [
      "Bash(*wrangler deploy*)",
      "Bash(*wrangler versions deploy*)",
      "Bash(*wrangler d1 * --remote*)"
    ],
    "deny": [
      "Read(.dev.vars*)",
      "Read(.env*)",
      "Read(!*.example)",
      "Read(.ai/qa/test-env.env)",
      "Read(.e2e-tiles/**)",
      "Edit(/src/routeTree.gen.ts)",
      "Edit(/drizzle/**)",
      "Edit(/worker-configuration.d.ts)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard*)",
      "Bash(git *--no-verify*)",
      "Bash(*wrangler secret put*)",
      "Bash(*wrangler secret bulk*)",
      "Bash(*wrangler d1 delete*)",
      "Bash(*wrangler r2 bucket delete*)",
      "Bash(*wrangler kv namespace delete*)",
      "Bash(*wrangler delete*)"
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonet-5-5": {
      "effortLevel": "high"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-file.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\" ] || node \"${CLAUDE_PROJECT_DIR}/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
