{
  "$schema": "node_modules/wrangler/config-schema.json",

  // planned.travel — Cloudflare Workers configuration.
  //
  // Resource ids below (D1 database_id, KV namespace ids) come from the
  // first-deploy runbook in docs/DEPLOY.md. Local development does not need real
  // ids: `vite dev` runs the bindings through Miniflare with local simulators.
  //
  // Secrets are NEVER declared here. They live in `.dev.vars` locally and in
  // `wrangler secret put` remotely. See `.dev.vars.example` for the full list.
  "name": "planned-travel",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Version preview URLs live on workers.dev and would bypass Cloudflare Access.
  "preview_urls": false,
  "upload_source_maps": true,

  // Deploying attaches both custom domains, so deploy.yml's smoke check has a
  // stable hostname without a manual dashboard step (docs/DEPLOY.md §8).
  "routes": [
    { "pattern": "planned.travel", "custom_domain": true },
    { "pattern": "www.planned.travel", "custom_domain": true },
  ],

  // Smart placement moves the Worker close to D1's primary region so that a
  // request that makes several sequential D1 round-trips pays the latency once
  // instead of once per query.
  "placement": { "mode": "smart" },

  // Workers Observability: structured logs from src/server/observability are
  // queryable in the dashboard and via `wrangler tail`.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
    // Traces are exported to Sentry as OTLP. `sentry-traces` is an account-level destination
    // created by hand in the dashboard (docs/DEPLOY.md §17.6) - `wrangler deploy` fails while it
    // is missing, so the destination goes in before this does. What it buys over the SDK's own
    // spans is the part of a request the SDK cannot see: the cold start, the platform's view of
    // the invocation, and the hops into bound services.
    //
    // `logs` has no `destinations` on purpose. The Worker already mirrors every LogRecord to
    // Sentry through the SDK (`enableLogs` plus `sentrySink` in src/server/observability), so a
    // log drain would deliver each line a second time and be billed for both.
    "traces": { "enabled": true, "destinations": ["sentry-traces"] },
  },

  // The deployed version's id, read by src/server/observability/sentry.ts as the Sentry `release`.
  // Without it every event is attributed to "unknown" and a regression cannot be tied to the deploy
  // that introduced it - which is most of what makes a stack trace actionable a week later.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  "vars": {
    "ENVIRONMENT": "production",
    "APP_NAME": "planned.travel",
    "APP_URL": "https://planned.travel",
    "LOG_LEVEL": "info",
    // Default Protomaps archive served by /api/tiles/*. Dated and never overwritten —
    // a named key is cached `immutable` for a year, and rolling back is flipping this
    // one var to the previous key (docs/DEPLOY.md §7.4, §7.5). Local dev overrides it
    // in .dev.vars to name whatever object its own miniflare bucket holds.
    "TILES_ARCHIVE_KEY": "basemaps/planet-20260818.pmtiles",
    // Public base for R2 `FILES` objects, used by the thumbnail pipeline.
    "FILES_PUBLIC_BASE": "https://files.planned.travel",
    "EMAIL_FROM": "planned.travel <no-reply@planned.travel>",
    "EMAIL_API_URL": "https://api.resend.com/emails",
    "BACKUP_RETENTION_DAYS": 30,
    "TASK_MAX_ATTEMPTS": 5,
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "planned-travel-db",
      "database_id": "a9738748-8c2d-4e67-8e6d-8dc55171d219",
      "migrations_dir": "drizzle",
    },
  ],

  "kv_namespaces": [
    // Short-TTL read cache + queue idempotency + reminder index.
    { "binding": "KV", "id": "3f473233842340f3ab9854c4b42e4495" },
    // Better Auth session store, read on nearly every authenticated request.
    { "binding": "SESSIONS", "id": "bb185731c4474d85860a97e0d4cc35fa" },
  ],

  "r2_buckets": [
    // User uploads: journal photos, import files, generated exports.
    { "binding": "FILES", "bucket_name": "planned-travel-files" },
    // Protomaps `.pmtiles` archives, served by /api/tiles/*.
    { "binding": "TILES", "bucket_name": "planned-travel-tiles" },
  ],

  // Workers AI: the model that turns a confirmation file into a draft booking
  // (docs/adr/0012-workers-ai-for-confirmation-extraction.md), reached only through
  // src/server/ai/bindings.ts. It runs on our own binding and never on a credential a
  // tenant supplies, because a per-tenant model credential is a cross-tenant leak here.
  //
  // It is worth this much comment because it changes the cost model rather than adding a
  // capability. Every other binding in this file is priced per stored byte or per request
  // against a quota we already buy; this one is priced per inference, so a single
  // tenant's loop is an invoice rather than a rate limit. Two documents still contradict
  // the decision and neither is ours to edit:
  // docs/plans/00-foundations.md's binding table records this row as "report only", on a
  // justification (BKG-04 out of scope) that no longer holds, and docs/ARCHITECTURE.md §8
  // prices Workers, D1, KV, DO, Queues and R2 and has no line for per-inference pricing at
  // all. Both are reported on PRD #167.
  //
  // The ceiling that bounds the spend is PLAN_RATE_CEILINGS.extraction_calls_per_month in
  // src/server/billing/limits.ts; nothing calls the binding until the stage that enforces
  // it lands, so declaring it here costs nothing until then.
  //
  // `remote: true` states a fact rather than choosing an option: Workers AI has no local
  // simulator, so a call made from `pnpm dev` reaches the real service and is billed like
  // any other. Without it wrangler warns about exactly that on every boot. Measured on
  // this checkout: the dev server behaves identically either way - it opens the same
  // remote connection, serves the same 200 and needs no Cloudflare credentials to start,
  // because nothing calls the binding yet.
  "ai": { "binding": "AI", "remote": true },

  // No SANDCASTLE_REGISTRY here, and that is the point: the sandcastle run
  // coordinator is deployed to staging alone (see env.staging below and
  // docs/adr/0009). A coordinator is only worth having if there is exactly one
  // of it - a second registry would let two fleets each believe they hold the
  // backlog, which is the failure it exists to prevent.
  "durable_objects": {
    "bindings": [{ "name": "TRIP_ROOM", "class_name": "TripRoom" }],
  },

  "migrations": [
    {
      "tag": "v1",
      // SQLite-backed Durable Objects: cheaper, higher storage limits, and the
      // only class type available on the Workers Free plan.
      "new_sqlite_classes": ["TripRoom"],
    },
  ],

  "queues": {
    "producers": [{ "binding": "TASKS", "queue": "planned-travel-tasks" }],
    "consumers": [
      {
        "queue": "planned-travel-tasks",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "max_concurrency": 4,
        "retry_delay": 10,
        "dead_letter_queue": "planned-travel-tasks-dlq",
      },
    ],
  },

  "triggers": {
    "crons": [
      // Reminder sweep: enqueue notification emails whose due time has passed.
      "*/15 * * * *",
      // Nightly D1 export to R2.
      "0 3 * * *",
      // Weekly retention prune of expired backups and export artifacts.
      "17 4 * * 1",
    ],
  },

  "env": {
    "staging": {
      "name": "planned-travel-staging",
      // Both false: the workers.dev origin would bypass Cloudflare Access.
      "workers_dev": false,
      "preview_urls": false,
      // Deploying attaches the custom domain, so deploy-staging.yml's smoke
      // check has a stable hostname without a manual dashboard step.
      "routes": [
        { "pattern": "staging.planned.travel", "custom_domain": true },
      ],
      "placement": { "mode": "smart" },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "logs": {
          "enabled": true,
          "invocation_logs": true,
          "head_sampling_rate": 1,
        },
        // Same destination as production, and no log drain, for the reasons given there. Staging
        // spans are told apart in Sentry by the script name the drain stamps on them.
        "traces": { "enabled": true, "destinations": ["sentry-traces"] },
      },
      // Same reason as production: staging events need a release too, or the pre-production
      // signal cannot be told apart from the release it was supposed to gate.
      "version_metadata": { "binding": "CF_VERSION_METADATA" },

      "vars": {
        "ENVIRONMENT": "staging",
        "APP_NAME": "planned.travel (staging)",
        "APP_URL": "https://staging.planned.travel",
        "LOG_LEVEL": "debug",
        // Same archive as production, and versioned for the same reason.
        "TILES_ARCHIVE_KEY": "basemaps/planet-20260818.pmtiles",
        "FILES_PUBLIC_BASE": "https://files-staging.planned.travel",
        "EMAIL_FROM": "planned.travel staging <no-reply@staging.planned.travel>",
        "EMAIL_API_URL": "https://api.resend.com/emails",
        "BACKUP_RETENTION_DAYS": 7,
        "TASK_MAX_ATTEMPTS": 3,
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "planned-travel-db-staging",
          "database_id": "0a30dba4-6978-494c-b2f0-2d02ca9a153e",
          "migrations_dir": "drizzle",
        },
      ],
      "kv_namespaces": [
        { "binding": "KV", "id": "f6926d91cf9b4a5687090bf89cb5a0b6" },
        { "binding": "SESSIONS", "id": "487cdb7ce2364ca1a61bce537429799c" },
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "planned-travel-files-staging" },
        { "binding": "TILES", "bucket_name": "planned-travel-tiles" },
      ],
      // Declared again rather than inherited: a named environment takes no binding from
      // the top level, so an `AI` left out here is an extraction that works in production
      // and throws on the deployment that is meant to catch that.
      "ai": { "binding": "AI", "remote": true },
      "durable_objects": {
        "bindings": [
          { "name": "TRIP_ROOM", "class_name": "TripRoom" },
          // Staging alone carries the sandcastle run coordinator: one object per
          // repository, so every claim for a backlog is decided in one thread.
          // The hostname is behind Cloudflare Access for good, which production
          // will not be once it launches.
          { "name": "SANDCASTLE_REGISTRY", "class_name": "SandcastleRegistry" },
        ],
      },
      // Append-only, per environment: a published tag is a fact about what this
      // worker already ran, so editing one re-runs history against a class that
      // has moved on.
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["TripRoom"] },
        { "tag": "v2", "new_sqlite_classes": ["SandcastleRegistry"] },
      ],
      "queues": {
        "producers": [
          { "binding": "TASKS", "queue": "planned-travel-tasks-staging" },
        ],
        "consumers": [
          {
            "queue": "planned-travel-tasks-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 2,
            "retry_delay": 10,
            "dead_letter_queue": "planned-travel-tasks-staging-dlq",
          },
        ],
      },
      "triggers": { "crons": ["0 3 * * *"] },
    },
  },
}
